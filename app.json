{
  "expo": {
    "name": "Push Office",
    "slug": "pushOffice_app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/push-office-icon.png",
    "scheme": "pushofficeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/images/push-office-adaptive-foreground.png",
        "monochromeImage": "./assets/images/push-office-adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hebi96.pushOffice_app",
      "allowBackup": false,
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/images/push-office-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/push-office-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA",
          "dark": {
            "backgroundColor": "#111315",
            "image": "./assets/images/push-office-splash-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "./plugins/with-local-assistant"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e5da6f1-57cb-4cf6-9d24-5a65efee7575"
      }
    }
  }
}
